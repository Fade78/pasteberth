[Unit]
Description=Pasteberth — browser clipboard to harness filesystem bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Default path for the documented clone; adapt it if the repository is elsewhere.
WorkingDirectory=%h/Depots/pasteberth
ExecStart=%h/Depots/pasteberth/bin/pasteberth
Restart=on-failure
RestartSec=2
TimeoutStopSec=90
UMask=0077

# Safe hardening for a user service:
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true

# Optional hardening (uncomment and adapt paths to YOUR zones; otherwise the
# service will refuse to start if a declared path is missing):
#ProtectSystem=full
#ProtectHome=read-only
#ReadWritePaths=%h/Depots %h/.config/pasteberth %h/.local/share/pasteberth

[Install]
WantedBy=default.target
