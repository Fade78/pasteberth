[Unit]
Description=Pasteberth — browser clipboard/files to harness filesystem bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Example paths only; adapt them to the repository and configuration you use.
WorkingDirectory=%h/PasteBerth
ExecStart=%h/PasteBerth/bin/pasteberth --config %h/PasteBerth/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=90
UMask=0077

# Safe hardening for a user service:
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true

# Optional hardening (uncomment and adapt paths to YOUR zones; otherwise the
# service will refuse to start if a declared path is missing):
#ProtectSystem=full
#ProtectHome=read-only
#ReadWritePaths=%h/PasteBerth/storage %h/PasteBerth/captures
# Add every configured zone directory and any parent created by
# create_directory=true. Keep zones outside /tmp and /var/tmp with PrivateTmp=true.

[Install]
WantedBy=default.target
