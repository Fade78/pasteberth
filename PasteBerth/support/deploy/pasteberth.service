[Unit]
Description=Pasteberth — browser clipboard/files to harness filesystem bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Example paths only; adapt them to the deployment and configuration you use.
WorkingDirectory=%h/PasteBerth
ExecStart=%h/PasteBerth/pasteberth --config %h/.config/pasteberth/config.toml
Restart=on-failure
RestartSec=2
TimeoutStopSec=90
UMask=0077

# Safe hardening for a user service:
NoNewPrivileges=true
PrivateTmp=true
RestrictSUIDSGID=true

# Optional hardening (uncomment and adapt paths to YOUR zones; otherwise the
# service will refuse to start if a declared path is missing):
#ProtectSystem=full
#ProtectHome=read-only
#ReadWritePaths=%h/.config/pasteberth %h/.local/share/pasteberth %h/.cache/pasteberth
# Add every configured zone directory and any parent created by
# create_directory=true, plus the password file and runtime lock directory.
# Keep zones outside /tmp and /var/tmp with PrivateTmp=true. The PasteBerth
# deployment itself should remain read-only.

[Install]
WantedBy=default.target
